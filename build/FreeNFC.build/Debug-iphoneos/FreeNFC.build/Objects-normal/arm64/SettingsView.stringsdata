        "location": {
          "startingColumn": 21,
          "startingLine": 82
        }
      },
      {
        "comment": "",
        "key": "MIFARE Ultralight / NTAG21x — read, write, erase, format, lock, memory editor, password, manual commands, .bin dump/restore.",
        "location": {
          "startingColumn": 22,
          "startingLine": 72
        }
      },
      {
        "comment": "",
        "key": "ISO 15693 (Vicinity) — read, write, lock, memory editor, manual commands, .bin dump/restore.",
        "location": {
          "startingColumn": 22,
          "startingLine": 73
        }
      },
      {
        "comment": "",
        "key": "ISO 7816 (Smart Card / Type 4) — NDEF read/write plus raw APDU commands. No raw memory access.",
        "location": {
          "startingColumn": 22,
          "startingLine": 76
        }
      },
      {
        "comment": "",
        "key": "FeliCa — NDEF read/write plus raw command passthrough. No raw memory access.",
        "location": {
          "startingColumn": 22,
          "startingLine": 77
        }
      },
      {
        "comment": "",
        "key": "MIFARE Classic — UID/detection only. Apple's CoreNFC blocks the authentication commands Classic cards need for sector access, so reading, writing, and duplicating aren't possible on iPhone.",
        "location": {
          "startingColumn": 22,
          "startingLine": 80
        }
      },
      {
        "comment": "",
        "key": "Writes to the lock, configuration and password pages are blocked by default, so a bad write can't brick a tag. The Memory Editor and .bin Restore have an override toggle for advanced use.",
        "location": {
          "startingColumn": 22,
          "startingLine": 83
        }
      },
      {
        "comment": "",
        "key": "Accidentally password-locked a tag? Tools → Password Protection → Recover clears protection and resets the password to factory (it can try the common defaults automatically).",
        "location": {
          "startingColumn": 22,
          "startingLine": 84
        }
      }
    ]
  },
  "version": 1
